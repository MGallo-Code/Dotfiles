#!/bin/sh
# coding-mastermind pre-commit hook (dotfiles) - INV-1 secrets, AGENTS==CLAUDE, INV-2 parity.
# Portable POSIX sh: runs on macOS and on Windows via git-bash.
# CI re-runs the same checks as the authoritative backstop. See INVARIANTS.md.
set -e

ROOT="$(git rev-parse --show-toplevel)"
# The checks parse TOML, so pick the first Python with tomllib (3.11+) or tomli. Apple's
# /usr/bin/python3 (3.9) is often first on PATH in agent sessions and has neither; the
# same probe as manifest.sh's configure_agent_integrations.
PY=""
for candidate in python3 /opt/homebrew/bin/python3 /usr/local/bin/python3 python; do
  command -v "$candidate" >/dev/null 2>&1 || continue
  if "$candidate" -c 'import importlib.util,sys; sys.exit(not (importlib.util.find_spec("tomllib") or importlib.util.find_spec("tomli")))' >/dev/null 2>&1; then
    PY="$(command -v "$candidate")"
    break
  fi
done
if [ -z "$PY" ]; then
  echo "pre-commit: no Python with tomllib/tomli found - failing closed (install Python 3.11+ or use --no-verify deliberately)" >&2
  exit 2
fi

# INV-1: no live credentials in the tracked tree.
"$PY" "$ROOT/scripts/ci/check-no-secrets.py" --staged

# AGENTS.md must stay byte-identical to CLAUDE.md (a copy, not a symlink, for Windows).
if ! cmp -s "$ROOT/AGENTS.md" "$ROOT/CLAUDE.md"; then
  echo "pre-commit: AGENTS.md and CLAUDE.md differ - run 'cp CLAUDE.md AGENTS.md' and re-stage" >&2
  exit 1
fi

# INV-2: cross-platform parity (check-parity.py is added by the parity task).
if [ -f "$ROOT/scripts/ci/check-parity.py" ]; then
  "$PY" "$ROOT/scripts/ci/check-parity.py"
fi

# INV-4 + INV-5: hub MCP wiring discipline (no inlined token; per-role via shared fn).
if [ -f "$ROOT/scripts/ci/check-hub-wiring.py" ]; then
  "$PY" "$ROOT/scripts/ci/check-hub-wiring.py"
fi

# Skill-target hygiene: no archived root leaks into an active list (manifest mode only;
# the machine-state --machine scan runs during `sync`, not here, so a commit never depends
# on local skill-link state).
if [ -f "$ROOT/scripts/ci/check-skill-targets.py" ]; then
  "$PY" "$ROOT/scripts/ci/check-skill-targets.py"
fi

# Cross-agent completion hooks preserve unrelated config, migrate legacy wiring,
# fail closed on malformed input, and remain idempotent.
if [ -f "$ROOT/scripts/ci/check-agent-integrations.py" ]; then
  "$PY" "$ROOT/scripts/ci/check-agent-integrations.py"
fi

# INV-9: no `local`/`declare` references a variable assigned earlier in the SAME statement
# (unbound under `set -u` - the class of bug that crashed sync mid-regen 2026-06-18).
if [ -f "$ROOT/scripts/ci/check-local-selfref.py" ]; then
  "$PY" "$ROOT/scripts/ci/check-local-selfref.py"
fi

# INV-14: trusted workspace launchers stay cwd-safe, explicit, and diagnosable.
if [ -f "$ROOT/scripts/ci/check-workspace-access.py" ]; then
  "$PY" "$ROOT/scripts/ci/check-workspace-access.py"
fi

# INV-15 trigger: the post-commit/merge/checkout hooks keep regenerating Codex's rules.
sh "$ROOT/scripts/ci/check-agent-rules-hooks.sh" >/dev/null || {
  echo "pre-commit: check-agent-rules-hooks failed - run: sh scripts/ci/check-agent-rules-hooks.sh" >&2; exit 1; }

# ADR-0006 cutover: links left at a moved source are repointed, live or dangling.
bash "$ROOT/scripts/ci/check-moved-links.sh" >/dev/null || {
  echo "pre-commit: check-moved-links failed - run: bash scripts/ci/check-moved-links.sh" >&2; exit 1; }

# INV-18: the services' code root resolves per machine; EA's generated .mcp.json retires.
bash "$ROOT/scripts/ci/check-code-root.sh" >/dev/null || {
  echo "pre-commit: check-code-root failed - run: bash scripts/ci/check-code-root.sh" >&2; exit 1; }

# INV-19: the UI-workflow nudge fires once per session, fails open, and registers once.
bash "$ROOT/scripts/ci/check-ui-nudge.sh" >/dev/null || {
  echo "pre-commit: check-ui-nudge failed - run: bash scripts/ci/check-ui-nudge.sh" >&2; exit 1; }

# INV-26: questions for Michael go through the questions page or a clean card (ADR-0011).
"$PY" "$ROOT/scripts/ci/check-ask.py" >/dev/null || {
  echo "pre-commit: check-ask failed - run: python3 scripts/ci/check-ask.py" >&2; exit 1; }

# INV-22: no live file names a repo's pre-ADR-0007 ~/Documents home.
"$PY" "$ROOT/scripts/ci/check-no-stale-paths.py" >/dev/null || {
  echo "pre-commit: check-no-stale-paths failed - run: python3 scripts/ci/check-no-stale-paths.py" >&2; exit 1; }

# INV-21: the move out of ~/Documents. About 13s, so only when its surface is staged.
if git -C "$ROOT" diff --cached --name-only | grep -qE '^(manifest\.sh|sync\.sh|setup\.sh|scripts/lib/workspace-migration\.sh|scripts/lib/ws_paths\.py|scripts/ci/check-workspace-migration\.sh)$'; then
  bash "$ROOT/scripts/ci/check-workspace-migration.sh" >/dev/null || {
    echo "pre-commit: check-workspace-migration failed - run: bash scripts/ci/check-workspace-migration.sh" >&2; exit 1; }
fi

# INV-20: sync's dirty-repo commit path keeps unrelated stashes and never commits an error message.
bash "$ROOT/scripts/ci/check-sync-commit.sh" >/dev/null || {
  echo "pre-commit: check-sync-commit failed - run: bash scripts/ci/check-sync-commit.sh" >&2; exit 1; }

# INV-24: private sync stays on Tailscale and never touches git. Fast and hermetic.
"$PY" "$ROOT/scripts/ci/check-private-sync.py" >/dev/null || {
  echo "pre-commit: check-private-sync failed - run: python3 scripts/ci/check-private-sync.py" >&2; exit 1; }

# INV-25: a vendor CLI run for a cross-check reads nothing beyond its prompt. About 20s, so only
# when its surface is staged.
if git -C "$ROOT" diff --cached --name-only | grep -qE '^(agent-skills/skills/(coding-mastermind-cross-check|doubt-driven-development)/SKILL\.md|docs/gemini-cross-check-setup\.md|scripts/setup-gemini-cross-check\.(sh|ps1)|scripts/ci/check-vendor-isolation\.py)$'; then
  "$PY" "$ROOT/scripts/ci/check-vendor-isolation.py" >/dev/null || {
    echo "pre-commit: check-vendor-isolation failed - run: python3 scripts/ci/check-vendor-isolation.py" >&2; exit 1; }
fi

# INV-17: resume-card hooks and the clear guard. About 10s, so only when their surface is staged.
if git -C "$ROOT" diff --cached --name-only | grep -qE '^(claude-config/global-hooks/context-card\.py|claude-config/model-profiles/compact/|scripts/ci/check-context-card\.py)'; then
  "$PY" "$ROOT/scripts/ci/check-context-card.py" >/dev/null || {
    echo "pre-commit: check-context-card failed - run: python3 scripts/ci/check-context-card.py" >&2; exit 1; }
fi

# INV-15: combined Codex/Gemini rule files regenerate from source and never lose a differing
# copy. The bash half only; Windows uses the PowerShell half, which CI runs on windows-latest.
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) ;;
  *) bash "$ROOT/scripts/ci/check-combined-rules.sh" >/dev/null || {
       echo "pre-commit: check-combined-rules failed - run: bash scripts/ci/check-combined-rules.sh" >&2; exit 1; } ;;
esac
