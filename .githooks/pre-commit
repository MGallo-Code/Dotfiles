#!/bin/sh
# coding-mastermind pre-commit hook (dotfiles) - INV-1 secrets, AGENTS==CLAUDE, INV-2 parity.
# Portable POSIX sh: runs on macOS and on Windows via git-bash.
# CI re-runs the same checks as the authoritative backstop. See INVARIANTS.md.
set -e

ROOT="$(git rev-parse --show-toplevel)"
# The checks parse TOML, so pick the first Python with tomllib (3.11+) or tomli. Apple's
# /usr/bin/python3 (3.9) is often first on PATH in agent sessions and has neither; the
# same probe as manifest.sh's configure_agent_integrations.
PY=""
for candidate in python3 /opt/homebrew/bin/python3 /usr/local/bin/python3 python; do
  command -v "$candidate" >/dev/null 2>&1 || continue
  if "$candidate" -c 'import importlib.util,sys; sys.exit(not (importlib.util.find_spec("tomllib") or importlib.util.find_spec("tomli")))' >/dev/null 2>&1; then
    PY="$(command -v "$candidate")"
    break
  fi
done
if [ -z "$PY" ]; then
  echo "pre-commit: no Python with tomllib/tomli found - failing closed (install Python 3.11+ or use --no-verify deliberately)" >&2
  exit 2
fi

# INV-1: no live credentials in the tracked tree.
"$PY" "$ROOT/scripts/ci/check-no-secrets.py" --staged

# AGENTS.md must stay byte-identical to CLAUDE.md (a copy, not a symlink, for Windows).
if ! cmp -s "$ROOT/AGENTS.md" "$ROOT/CLAUDE.md"; then
  echo "pre-commit: AGENTS.md and CLAUDE.md differ - run 'cp CLAUDE.md AGENTS.md' and re-stage" >&2
  exit 1
fi

# INV-2: cross-platform parity (check-parity.py is added by the parity task).
if [ -f "$ROOT/scripts/ci/check-parity.py" ]; then
  "$PY" "$ROOT/scripts/ci/check-parity.py"
fi

# INV-4 + INV-5: hub MCP wiring discipline (no inlined token; per-role via shared fn).
if [ -f "$ROOT/scripts/ci/check-hub-wiring.py" ]; then
  "$PY" "$ROOT/scripts/ci/check-hub-wiring.py"
fi

# Skill-target hygiene: no archived root leaks into an active list (manifest mode only;
# the machine-state --machine scan runs during `sync`, not here, so a commit never depends
# on local skill-link state).
if [ -f "$ROOT/scripts/ci/check-skill-targets.py" ]; then
  "$PY" "$ROOT/scripts/ci/check-skill-targets.py"
fi

# Cross-agent completion hooks preserve unrelated config, migrate legacy wiring,
# fail closed on malformed input, and remain idempotent.
if [ -f "$ROOT/scripts/ci/check-agent-integrations.py" ]; then
  "$PY" "$ROOT/scripts/ci/check-agent-integrations.py"
fi

# INV-9: no `local`/`declare` references a variable assigned earlier in the SAME statement
# (unbound under `set -u` - the class of bug that crashed sync mid-regen 2026-06-18).
if [ -f "$ROOT/scripts/ci/check-local-selfref.py" ]; then
  "$PY" "$ROOT/scripts/ci/check-local-selfref.py"
fi

# INV-14: trusted workspace launchers stay cwd-safe, explicit, and diagnosable.
if [ -f "$ROOT/scripts/ci/check-workspace-access.py" ]; then
  "$PY" "$ROOT/scripts/ci/check-workspace-access.py"
fi

# INV-15: combined Codex/Gemini rule files regenerate from source and never lose a differing
# copy. The bash half only; Windows uses the PowerShell half, which CI runs on windows-latest.
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) ;;
  *) bash "$ROOT/scripts/ci/check-combined-rules.sh" >/dev/null || {
       echo "pre-commit: check-combined-rules failed - run: bash scripts/ci/check-combined-rules.sh" >&2; exit 1; } ;;
esac
