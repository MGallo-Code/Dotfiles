# --- Secrets / credentials (INV-1): never track live key material ---
# Private keys
id_rsa
id_ed25519
*.pem
*.key
*.ppk
# Real SSH config (only the template is tracked)
ssh/config
# Env / token files
.env
*.env
.env.*
*.token
*.token.json
token.json
credentials.json
client_secret*.json

# --- OS / editor junk ---
.DS_Store
**/.DS_Store
Thumbs.db

# --- Python build artifacts (the scripts/*.py generators) ---
__pycache__/
*.pyc

# --- Machine-local Claude Code config (per-machine; never tracked) ---
.claude/settings.local.json

# --- Playwright MCP debug artifacts (console logs + page snapshots; machine-local) ---
.playwright-mcp/

# --- Override the global gitignore: track the per-repo agent constitution here ---
# (~/.gitignore_global ignores CLAUDE.md everywhere; this repo commits it, kept
#  byte-identical to AGENTS.md by the pre-commit cmp check.)
!CLAUDE.md
