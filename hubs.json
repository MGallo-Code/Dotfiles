[
  {
    "name": "courier",
    "port": 8765,
    "serve_path": "",
    "mcp_path": "/mcp",
    "token_file": "~/.config/courier/auth-token",
    "run_cmd": "/usr/bin/env COURIER_NEXUS_DB=$HOME/.local/share/nexus/nexus.db PYTHONPATH=$CODE_ROOT/courier/src:$CODE_ROOT/ea_mcp_remote/src $CODE_ROOT/courier/.venv/bin/python -u -m courier.server"
  },
  {
    "name": "calendar",
    "port": 8766,
    "serve_path": "/calendar",
    "mcp_path": "/mcp",
    "token_file": "~/.config/calendar/auth-token",
    "run_cmd": "/usr/bin/env EA_CALENDAR_FORCE_FILE=1 PYTHONPATH=$CODE_ROOT/calendar/src:$CODE_ROOT/ea_mcp_remote/src $CODE_ROOT/calendar/.venv/bin/python -u -m ea_calendar.server"
  },
  {
    "name": "nexus",
    "port": 8767,
    "serve_path": "/nexus",
    "mcp_path": "/mcp",
    "token_file": "~/.config/nexus/auth-token",
    "run_cmd": "/usr/bin/env NEXUS_DB_MUST_EXIST=1 NEXUS_DB=$HOME/.local/share/nexus/nexus.db node $CODE_ROOT/nexus/dist/server.js"
  }
]
